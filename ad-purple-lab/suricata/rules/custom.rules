# ============================================================
# custom.rules - Reglas adicionales para AD Purple Lab
# Complementan local.rules con detección más granular.
# SIDs: 1000001 - 1000099 (rango reservado para este lab)
# ============================================================

# ── LDAP Enumeration ─────────────────────────────────────────
alert tcp any any -> any 389 (msg:"AD-LAB LDAP enumeration attempt"; flow:to_server,established; classtype:policy-violation; sid:1000001; rev:2;)
alert tcp any any -> any 3268 (msg:"AD-LAB LDAP Global Catalog query"; flow:to_server,established; classtype:policy-violation; sid:1000004; rev:1;)
alert tcp any any -> any 636 (msg:"AD-LAB LDAPS connection"; flow:to_server,established; classtype:policy-violation; sid:1000005; rev:1;)

# ── Kerberos ──────────────────────────────────────────────────
alert tcp any any -> any 88 (msg:"AD-LAB Kerberos abnormal traffic volume"; flow:to_server,established; threshold:type both,track by_src,count 20,seconds 10; classtype:protocol-command-decode; sid:1000002; rev:2;)
alert udp any any -> any 88 (msg:"AD-LAB Kerberos UDP request"; threshold:type both,track by_src,count 15,seconds 10; classtype:protocol-command-decode; sid:1000006; rev:1;)

# ── SMB / CIFS ────────────────────────────────────────────────
alert tcp any any -> any 445 (msg:"AD-LAB Possible SMB scanning"; flow:to_server; threshold:type both,track by_src,count 5,seconds 5; classtype:policy-violation; sid:1000003; rev:2;)
alert tcp any any -> any 445 (msg:"AD-LAB SMB IPC$ access (RPC enumeration)"; flow:to_server,established; content:"IPC$"; classtype:policy-violation; sid:1000007; rev:1;)

# ── DCE/RPC ───────────────────────────────────────────────────
alert tcp any any -> any 135 (msg:"AD-LAB DCE-RPC endpoint mapper query"; flow:to_server,established; classtype:protocol-command-decode; sid:1000008; rev:1;)

# ── WinRM ─────────────────────────────────────────────────────
alert tcp any any -> any 5985 (msg:"AD-LAB WinRM HTTP connection"; flow:to_server,established; classtype:policy-violation; sid:1000009; rev:1;)
alert tcp any any -> any 5986 (msg:"AD-LAB WinRM HTTPS connection"; flow:to_server,established; classtype:policy-violation; sid:1000010; rev:1;)

# ── DNS ───────────────────────────────────────────────────────
alert udp any any -> any 53 (msg:"AD-LAB Rapid DNS queries (possible enumeration)"; threshold:type both,track by_src,count 30,seconds 5; classtype:policy-violation; sid:1000011; rev:1;)
