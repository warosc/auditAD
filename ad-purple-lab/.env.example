# ============================================================
# AD Purple Lab - Variables de entorno
# Copia este archivo a .env y ajusta los valores a tu laboratorio.
# NUNCA commitees .env con credenciales reales.
# ============================================================

# ── Active Directory ─────────────────────────────────────────
AD_DOMAIN=corp.local
AD_FQDN=dc01.corp.local
DC_IP=192.168.1.10
LDAP_PORT=389
LDAPS_PORT=636
KERBEROS_REALM=CORP.LOCAL

# ── Credenciales de auditoría ────────────────────────────────
# Usa una cuenta de solo lectura dedicada. Nunca uses admin de dominio.
AD_USERNAME=audit.user
AD_PASSWORD=ChangeMe123!
AD_USER_DN=CN=audit.user,CN=Users,DC=corp,DC=local
LDAP_BASE_DN=DC=corp,DC=local

# ── Red del laboratorio ──────────────────────────────────────
DNS_SERVER=192.168.1.10
TARGET_SUBNET=192.168.1.0/24

# ── Zona horaria ─────────────────────────────────────────────
TZ=America/Guatemala
TIMEZONE=America/Guatemala

# ── Control de auditoría ─────────────────────────────────────
# SAFE_MODE=true desactiva cualquier acción que modifique el AD
SAFE_MODE=true
ENABLE_LDAP_DUMP=true
ENABLE_BLOODHOUND=true
ENABLE_PORT_CHECKS=true

# ── Neo4j ────────────────────────────────────────────────────
# Formato: usuario/contraseña
NEO4J_AUTH=neo4j/ChangeThisNeo4jPass123!
NEO4J_HEAP_INIT=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# ── Captura de tráfico ───────────────────────────────────────
# Interfaz de red para Zeek y Suricata.
# En modo bridge Docker = eth0 (dentro del contenedor).
# En modo host = interfaz real del host (ej: ens33, eth0, enp3s0).
CAPTURE_INTERFACE=eth0

# ── Rate limiting de auditoría ───────────────────────────────
# Pausa en segundos entre consultas LDAP (evita sobrecarga del DC)
LDAP_DELAY=0.2
# Tasa máxima de paquetes/seg para nmap port scan
PORTSCAN_RATE=20
# Hilos de BloodHound (reducir si el DC es sensible)
BLOODHOUND_THREADS=5
# Timeout en segundos por operación de BloodHound
BLOODHOUND_TIMEOUT=30

# ── OpenSearch ───────────────────────────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# ── Wazuh (opcional, requiere wazuh/docker-compose.override.yml) ──
# IP del host donde corre Docker (para que el agente Windows conecte)
WAZUH_MANAGER_HOST=192.168.1.100
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
