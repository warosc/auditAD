{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH_SURICATA",
      "label": "OpenSearch-Suricata",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.14.3"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Alertas de Suricata IDS para AD Purple Lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_SURICATA}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "alias": "Alertas",
          "bucketAggs": [
            {
              "field": "@timestamp",
              "id": "2",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_SURICATA}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "event_type:alert",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Alertas por hora",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_SURICATA}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "alert.signature.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "15" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_SURICATA}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "event_type:alert",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Top 15 firmas de alertas",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "alert.signature.keyword": "Firma",
              "Count": "Ocurrencias"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_SURICATA}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 3,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "src_ip.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_SURICATA}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "event_type:alert",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Top IPs origen de alertas",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "src_ip.keyword": "IP Origen",
              "Count": "Alertas"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_SURICATA}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "alias": "Total alertas",
          "bucketAggs": [],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_SURICATA}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "event_type:alert",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Total alertas (rango)",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["suricata", "ids", "purple-lab"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Suricata — Alertas IDS",
  "uid": "purplelab-suricata",
  "version": 1
}
