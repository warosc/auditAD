{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH_ZEEK",
      "label": "OpenSearch-Zeek",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.14.3"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "Consultas LDAP capturadas por Zeek - AD Purple Lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "alias": "Consultas LDAP",
          "bucketAggs": [
            {
              "field": "ts",
              "id": "2",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-* AND _type:ldap",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        },
        {
          "alias": "Bind LDAP",
          "bucketAggs": [
            {
              "field": "ts",
              "id": "4",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "3", "type": "count" }],
          "query": "_index:zeek-* AND _type:ldap_bind",
          "queryType": "lucene",
          "refId": "B",
          "timeField": "ts"
        }
      ],
      "title": "Actividad LDAP en el tiempo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "id.orig_h.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Top IPs origen de consultas LDAP",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "id.orig_h.keyword": "IP Origen",
              "Count": "Consultas"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 3,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "filter.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Top filtros LDAP usados",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "filter.keyword": "Filtro LDAP",
              "Count": "Ocurrencias"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }
      },
      "targets": [
        {
          "alias": "Total consultas LDAP",
          "bucketAggs": [],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Total consultas LDAP",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ldap", "zeek", "purple-lab"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LDAP — Consultas al Directorio",
  "uid": "purplelab-ldap",
  "version": 1
}
