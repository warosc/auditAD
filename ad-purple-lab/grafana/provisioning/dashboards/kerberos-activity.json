{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH_ZEEK",
      "label": "OpenSearch-Zeek",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.14.3"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "Actividad Kerberos capturada por Zeek - AD Purple Lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "alias": "AS-REQ (TGT requests)",
          "bucketAggs": [
            {
              "field": "ts",
              "id": "2",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-* AND request_type:AS",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        },
        {
          "alias": "TGS-REQ (service tickets)",
          "bucketAggs": [
            {
              "field": "ts",
              "id": "4",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "3", "type": "count" }],
          "query": "_index:zeek-* AND request_type:TGS",
          "queryType": "lucene",
          "refId": "B",
          "timeField": "ts"
        }
      ],
      "title": "Solicitudes Kerberos por tipo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "id.orig_h.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-* AND request_type:AS",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Top clientes AS-REQ (solicitudes TGT)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "id.orig_h.keyword": "IP Cliente",
              "Count": "TGT Requests"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 3,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "error_msg.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-* AND success:false",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Errores Kerberos (autenticaciones fallidas)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "error_msg.keyword": "Error",
              "Count": "Ocurrencias"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["kerberos", "zeek", "purple-lab"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Kerberos — Actividad AD",
  "uid": "purplelab-kerberos",
  "version": 1
}
