{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH_ZEEK",
      "label": "OpenSearch-Zeek",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.14.3"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "Pie chart",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "Conexiones de red capturadas por Zeek - AD Purple Lab",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "alias": "Conexiones",
          "bucketAggs": [
            {
              "field": "ts",
              "id": "2",
              "settings": { "interval": "auto", "min_doc_count": "0" },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-* AND _type:conn",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Conexiones de red por hora",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "proto.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "5" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Protocolos (TCP/UDP)",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 3,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "id.resp_p",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Top puertos destino",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "id.resp_p": "Puerto Destino",
              "Count": "Conexiones"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH_ZEEK}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 4,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "field": "id.orig_h.keyword",
              "id": "2",
              "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" },
              "type": "terms"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH_ZEEK}"
          },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "_index:zeek-*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "ts"
        }
      ],
      "title": "Top IPs origen",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "id.orig_h.keyword": "IP Origen",
              "Count": "Conexiones"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["zeek", "connections", "purple-lab"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Zeek — Conexiones de Red",
  "uid": "purplelab-zeek",
  "version": 1
}
